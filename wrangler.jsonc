{
  // Cloudflare Workers config: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "picks-league",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // The idempotent tick: posts the day's slate after SLATE_HOUR ET (once), then
  // sweeps for finals. Cron is UTC and ET shifts with daylight saving, so the
  // trigger fires every 15 minutes and the tick decides what, if anything, to
  // do. Any tick can fail; the next one catches up.
  "triggers": { "crons": ["*/15 * * * *"] },

  // No database_id on purpose: `wrangler deploy` (and the Deploy to Cloudflare
  // button) creates the database and writes the id back here. Keep that line out
  // of the template; a fork may commit it.
  "d1_databases": [{ "binding": "DB", "database_name": "picks-league" }],

  // Everything the Worker needs from Discord is a secret (see .dev.vars.example),
  // so one config file serves every deployment. Optional: TICK_KEY, which turns
  // on the authenticated POST /tick route for an external scheduler (README).
  "observability": { "enabled": true }
}
